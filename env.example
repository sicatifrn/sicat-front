# =============================================================================
# SICAT Front — variáveis de ambiente
# Copie para .env na raiz do sicat-front
# =============================================================================

# URL base da API do backend SICAT (sem barra no final)
# Desenvolvimento com proxy ou backend direto:
VITE_API_BASE_URL=http://localhost:7000
# Produção (mesmo domínio com proxy /api):
# VITE_API_BASE_URL=/api
# Produção (API em subdomínio):
# VITE_API_BASE_URL=https://api.seudominio.com
